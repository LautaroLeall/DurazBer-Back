PORT=5000
NODE_ENV=development

# Credenciales y URI de MongoDB Atlas
MONGODB_USERNAME=tu_usuario
MONGODB_PASSWORD=tu_contraseña
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@durazber.frzo2gd.mongodb.net/durazber?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@durazber.frzo2gd.mongodb.net/durazber?retryWrites=true&w=majority

# Seguridad y Autenticación
JWT_SECRET=tu_jwt_secret_super_seguro

# Origen Permitido para CORS
CLIENT_URL=http://localhost:5173

# Política de retención de datos rodante (Purga automática cada 3 meses)
DATA_RETENTION_MONTHS=3
